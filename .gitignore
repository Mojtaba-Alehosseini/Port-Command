# Gradle / build output
.gradle/
build/

# Runtime artefacts
logs/
save/

# JADE runtime artefacts (regenerated on every container boot)
APDescription.txt
MTPs-*.txt

# Native / licensed jars — JADE must NOT be committed (license).
# .gitkeep files in lib/ are still tracked.
**/lib/*.jar

# Rasa trained models (regenerated) — keep the dir, ignore the .tar.gz models
nlp-python/rasa/models/*
!nlp-python/rasa/models/.gitkeep
# Rasa run/test artefacts (regenerated)
nlp-python/rasa/results/
nlp-python/rasa/.rasa/
nlp-python/rasa/graph.html

# Python
__pycache__/
*.pyc
.venv/
.venv-rasa/
venv/
.pytest_cache/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db
